# 闲鱼本地价格服务配置样例。复制为 .env 后按需修改。
# ⚠️ 本文件不得包含任何真实凭据；.env 已被 .gitignore 排除。

# --- 监听 ---
# 默认只监听本机。改成 0.0.0.0 而不设 ALLOW_REMOTE_ACCESS=true 会**启动失败**，
# 这是刻意的：指南 §9 要求不得「只改成 0.0.0.0 就宣布安全」。
# 确需跨设备访问请优先用 Tailscale / SSH 隧道，而不是直接暴露端口。
APP_HOST=127.0.0.1
APP_PORT=8765
ALLOW_REMOTE_ACCESS=false
LOG_LEVEL=INFO
# 默认写入有界轮转日志，可改为其他可写路径。
LOG_FILE=./data/logs/bestprice.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# --- 存储 ---
DATABASE_PATH=./data/price.sqlite3
# 备份落点由 scripts/backup-sqlite.sh 决定，默认 data/backups/
# 上游 commit 记录文件（由 scripts/setup.sh 写入，用于 search_runs.source_commit 追溯）
UPSTREAM_COMMIT_FILE=./data/upstream-commit.txt

# --- 采集器 ---
XIANYU_ADAPTER=upstream
# 选项 A 为进程内 import，不起上游 HTTP 服务，故无需 XIANYU_UPSTREAM_URL。
# 上游默认 --host 0.0.0.0，本项目刻意不启动它，避免多一个对外监听面。
XIANYU_UPSTREAM_PATH=./upstream/xianyu_spider
# 留空则从 UPSTREAM_COMMIT_FILE 读取；再没有就记为 null
XIANYU_SOURCE_COMMIT=

# --- 频率与并发（保守起点，不代表平台授权频率）---
MAX_SEARCH_PAGES=3
# MVP 只支持 1：SQLite 单写者 + 低频访问平台。设成别的值会启动失败。
MAX_CONCURRENT_SEARCHES=1
MIN_SECONDS_BETWEEN_SEARCHES=30
SECONDS_BETWEEN_PAGES=3
# pace 默认只影响可选等待；以下开关为 false 时，旧的 30 秒下限继续生效。
ALLOW_FASTER_PACE=false
PLATFORM_FLOOR_SECONDS=10
ECONOMY_GAP_SECONDS=60
BALANCED_GAP_SECONDS=30
FAST_GAP_SECONDS=12
MAX_PENDING_JOBS=12
SEARCH_CACHE_TTL_SECONDS=600
RATE_LIMIT_COOLDOWN_SECONDS=300
# 出现风控/验证码即停止自动操作，不要靠调小这两个值硬撞
# 有效样本少于此值时统计会标 insufficient_sample=true
MIN_SAMPLE_THRESHOLD=8

# --- 可选云端文本分析（默认关闭；关闭时仍有保守规则基线）---
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
# 仅放在本机 .env；不得写进日志、URL、报告或 Git
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=6000
